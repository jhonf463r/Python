from pydub import AudioSegment
import numpy as np
import scipy.signal as signal

def load_audio(file_path):
    # Cargar la canción
    return AudioSegment.from_file(file_path)

def check_stereo(audio):
    # Verificar si la canción es estéreo o mono
    if audio.channels == 1:
        print("La canción es mono.")
        return 'mono'
    elif audio.channels == 2:
        print("La canción es estéreo.")
        return 'stereo'
    else:
        print("La canción tiene más de dos canales.")
        return 'multi-channel'

def normalize_audio(samples):
    # Normalizar valores para que estén entre -1 y 1
    max_value = np.max(np.abs(samples))
    return samples / max_value

def analyze_balance(audio):
    # Convertir a arrays de numpy para análisis
    samples = np.array(audio.get_array_of_samples())
    channels = audio.channels

    if channels == 2:
        # Separar canales
        left_channel = samples[::2].astype(np.float64)
        right_channel = samples[1::2].astype(np.float64)

        # Normalizar canales para evitar errores
        left_channel = normalize_audio(left_channel)
        right_channel = normalize_audio(right_channel)

        # Analizar balance (RMS - Root Mean Square)
        left_rms = np.sqrt(np.mean(left_channel**2))
        right_rms = np.sqrt(np.mean(right_channel**2))

        print(f"RMS Canal Izquierdo: {left_rms}")
        print(f"RMS Canal Derecho: {right_rms}")
        
        if np.abs(left_rms - right_rms) > 0.05:  # Ajustar el umbral según necesidad
            print("Los canales izquierdo y derecho están desbalanceados.")
        else:
            print("Los canales están bien balanceados.")
    else:
        print("No se puede analizar el balance, ya que no es estéreo.")

def analyze_dynamic_range(audio):
    samples = np.array(audio.get_array_of_samples(), dtype=np.float64)
    
    # Normalizar valores
    samples = normalize_audio(samples)
    
    # Calcular la amplitud media
    mean_amplitude = np.mean(np.abs(samples))
    print(f"Amplitud media: {mean_amplitude:.5f}")
    
    # Detectar picos (se asegura que no haya picos que distorsionen)
    max_amplitude = np.max(np.abs(samples))
    print(f"Amplitud máxima: {max_amplitude:.5f}")
    
    if max_amplitude >= 0.95:
        print("¡Cuidado! La canción tiene picos que podrían causar distorsión.")
    else:
        print("El nivel de picos está dentro del rango adecuado.")

def check_audio_quality(file_path):
    # Cargar audio
    audio = load_audio(file_path)
    
    # Verificar estéreo/mono
    check_stereo(audio)
    
    # Verificar balance de canales en caso de estéreo
    if audio.channels == 2:
        analyze_balance(audio)
    
    # Analizar el rango dinámico
    analyze_dynamic_range(audio)

