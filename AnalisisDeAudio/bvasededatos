import pandas as pd
import sqlite3

# Ruta del archivo Excel
file_path = 'C:/Users/faber/Documents/Python/AnalisisDeAudio/Publicaciones-2024_12_05-14_05.xlsx'

# Leer el archivo Excel
excel_data = pd.ExcelFile(file_path)
data_publicaciones = excel_data.parse("Publicaciones")

# Limpiar y preparar los datos
data_cleaned = data_publicaciones.iloc[2:]  # Saltar las dos primeras filas con encabezados
data_cleaned.columns = data_cleaned.iloc[0]  # Asignar nombres de columna desde la fila restante
data_cleaned = data_cleaned[1:]  # Eliminar la fila de nombres duplicados
data_cleaned = data_cleaned.reset_index(drop=True)

# Limpiar los nombres de las columnas (solo si son cadenas)
data_cleaned.columns = [col.strip() if isinstance(col, str) else col for col in data_cleaned.columns]

# Inspeccionar columnas disponibles
print("Columnas disponibles en el archivo:")
for i, col in enumerate(data_cleaned.columns):
    print(f"{i}: {col}")

# Ver las primeras filas del DataFrame después de la limpieza
print("Primeras filas de data_cleaned:")
print(data_cleaned.head())

# Verificar la existencia de la columna 'Cantidad'
if 'Cantidad' in data_cleaned.columns:
    print("La columna 'Cantidad' está presente.")
else:
    print("La columna 'Cantidad' no está presente.")

# Seleccionar columnas específicas por índice
# Según el resultado de columnas, seleccionamos las que están en los índices correctos
mercado_libre_column = data_cleaned.columns[7]  # Primera ocurrencia de "Mercado Libre"
mercado_shops_column = data_cleaned.columns[8]  # Primera ocurrencia de "Mercado Shops"

# Convertir columnas numéricas
data_cleaned["Cantidad"] = pd.to_numeric(data_cleaned["Cantidad"], errors='coerce').fillna(0).astype(int)
data_cleaned[mercado_libre_column] = pd.to_numeric(data_cleaned[mercado_libre_column], errors='coerce').fillna(0)
data_cleaned[mercado_shops_column] = pd.to_numeric(data_cleaned[mercado_shops_column], errors='coerce').fillna(0)

# Conectar a SQLite
db_path = 'StockDB_Filled.db'
conn = sqlite3.connect(db_path)
cursor = conn.cursor()

# Crear la tabla
cursor.execute(f"""
CREATE TABLE IF NOT EXISTS Products (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    item_id TEXT,
    sku TEXT,
    title TEXT,
    quantity INTEGER,
    marketplace_price REAL,
    mshops_price REAL,
    status TEXT,
    category TEXT,
    warranty_type TEXT,
    manufacturing_time TEXT
)
""")

# Insertar los datos
for _, row in data_cleaned.iterrows():
    cursor.execute(""" 
    INSERT INTO Products (
        item_id, sku, title, quantity, marketplace_price, mshops_price,
        status, category, warranty_type, manufacturing_time
    ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    """, (
        str(row.get("Número de publicación")),
        str(row.get("SKU")),
        str(row.get("Título")),
        row.get("Cantidad"),
        row.get(mercado_libre_column),
        row.get(mercado_shops_column),
        str(row.get("Estado")),
        str(row.get("Categoría")),
        str(row.get("Tipo de garantía")),
        str(row.get("Tiempo de disponibilidad del producto (días)"))
    ))

# Guardar y cerrar
conn.commit()
conn.close()

print(f"Base de datos creada y guardada en: {db_path}")
