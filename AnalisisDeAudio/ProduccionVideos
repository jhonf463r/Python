import librosa
import librosa.display
import numpy as np
import matplotlib.pyplot as plt
import soundfile as sf

def process_audio(audio_file_path):
    # Cargar el archivo de audio
    y, sample_rate = librosa.load(audio_file_path)
    print(f"Procesando el archivo: {audio_file_path}")
    return y, sample_rate

def analyze_bpm(y, sample_rate):
    # Estimar el tempo o BPM del audio
    tempo, _ = librosa.beat.beat_track(y=y, sr=sample_rate)
    print(f"Ritmo detectado (BPM): {tempo}")
    return tempo

def suggest_scenes(audio_file_path):
    # Cargar el archivo de audio
    y, sample_rate = librosa.load(audio_file_path)
    
    # Calcular la envolvente de los onsets (onset strength)
    onset_env = librosa.onset.onset_strength(y=y, sr=sample_rate)
    
    # Detectar los momentos en los que ocurren los onsets
    onset_frames = librosa.onset.onset_detect(onset_envelope=onset_env, sr=sample_rate)
    
    # Convertir los onsets a tiempo (en segundos)
    onset_times = librosa.frames_to_time(onset_frames, sr=sample_rate)
    
    print(f"Onsets detectados en los tiempos: {onset_times}")
    
    # Sugerir escenas basadas en los onsets detectados
    scene_suggestions = []
    for onset in onset_times:
        scene_suggestions.append(f"Sugerencia de escena para el segundo {onset:.2f}")
    
    return scene_suggestions

def main(audio_file_path):
    # Procesar el audio
    y, sample_rate = process_audio(audio_file_path)
    
    # Analizar el BPM
    bpm = analyze_bpm(y, sample_rate)
    
    # Sugerir escenas basadas en el análisis del audio
    scene_suggestions = suggest_scenes(audio_file_path)
    
    print("Sugerencias para escenas...")
    for suggestion in scene_suggestions:
        print(suggestion)

