import speech_recognition as sr

# Ruta del archivo WAV
audio_file = "C:\\Users\\faber\\Documents\\Python\\AnalisisDeAudio\\cumbiaHS.wav"


# Crear un objeto Recognizer
recognizer = sr.Recognizer()

try:
    # Cargar el archivo de audio
    with sr.AudioFile(audio_file) as source:
        print("Cargando el audio...")
        audio_data = recognizer.record(source)  # Lee todo el audio

    # Usar reconocimiento de voz para convertir audio a texto
    print("Reconociendo el audio...")
    text = recognizer.recognize_google(audio_data, language="es-ES")  # Cambiar idioma si no es español
    print("\nTexto transcrito:")
    print(text)

except FileNotFoundError:
    print("El archivo de audio no fue encontrado. Por favor, verifica la ruta.")
except sr.UnknownValueError:
    print("No se pudo entender el audio.")
except sr.RequestError as e:
    print(f"No se pudo conectar al servicio de reconocimiento. Error: {e}")
