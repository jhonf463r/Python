+def test_open_intermediate_handle_prevents_directory_replacement(tmp_path: Path, monkeypatch) -> None:  # type: ignore[no-untyped-def]
+    (tmp_path / "parent").mkdir()
+    (tmp_path / "parent" / "child.txt").write_text("inside")
+    outside = tmp_path.parent / f"{tmp_path.name}_replacement"
+    outside.mkdir(exist_ok=True)
+    (outside / "child.txt").write_text("outside")
+    root = _root_capability(tmp_path)
+    original = rooted_open._WindowsNative.open_component
+    substitution_attempts: list[str] = []
+
+    def observe(self, parent_handle: int, component: str, *, final: bool) -> int:
+        if component == "child.txt":
+            try:
+                os.rename(tmp_path / "parent", tmp_path / "parent-held")
+            except OSError:
+                substitution_attempts.append("blocked")
+            else:
+                substitution_attempts.append("unexpectedly-renamed")
+                os.rename(tmp_path / "parent-held", tmp_path / "parent")
+        return original(self, parent_handle, component, final=final)
+
+    monkeypatch.setattr(rooted_open._WindowsNative, "open_component", observe)
+    try:
+        capability = _open_file(root, "parent/child.txt")
+        try:
+            assert substitution_attempts == ["blocked"]
+            assert read_repo_file(capability)["content"] == "inside"
+        finally:
+            capability.close()
+    finally:
+        root.close()
+
