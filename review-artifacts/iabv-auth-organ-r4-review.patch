@@ -0,0 +1,136 @@
+"""Deny-first sequencing for a future root-bound protected file read.
+
+The MCP server constructs this flow with an unconfigured coordinator and no
+root provider. The configurable collaborators exist only as internal seams;
+they are not constructor arguments, MCP inputs, container fields or settings.
+Python object privacy is not a boundary against arbitrary in-process code.
+"""
+
+from __future__ import annotations
+
+from typing import Any, Protocol
+
+from iabv_v15.infra.mcp.audit_tools.opened_target import NativeOpenedTargetCapability
+from iabv_v15.infra.mcp.audit_tools.rooted_open import (
+    NativeWorkspaceRootCapability,
+    open_target_relative_to_root,
+)
+from iabv_v15.services.security.read_authorization import (
+    AuthorizationEvidenceBundle,
+    ProtectedReadOperation,
+    ProtectedReadRequest,
+    ReadDestination,
+    ReadAuthorizationCoordinator,
+    RequestedReadTarget,
+)
+
+
+class _RootProvider(Protocol):
+    def acquire(self) -> NativeWorkspaceRootCapability: ...
+
+
+class ProtectedReadComposer:
+    """Compose G1/G2 preflight, rooted open, final decision and same-cap read."""
+
+    __slots__ = ("_coordinator", "_root_provider", "_opener", "_reader")
+
+    def __init__(
+        self,
+        coordinator: Any,
+        root_provider: _RootProvider | None,
+        *,
+        opener: Any = open_target_relative_to_root,
+        reader: Any,
+    ) -> None:
+        self._coordinator = coordinator
+        self._root_provider = root_provider
+        self._opener = opener
+        self._reader = reader
+
+    def read_file(self, raw_target: object) -> dict[str, object]:
+        request = ProtectedReadRequest(
+            operation=ProtectedReadOperation.READ_REPO_FILE,
+            target=RequestedReadTarget(raw_target),
+        )
+        # The configured production coordinator has no G1/G2 providers and
+        # denies here, before the root provider or target path is touched.
+        try:
+            preflight = self._coordinator.assess(request)
+        except Exception:
+            return _blocked("AUTHORIZATION_PREFLIGHT_FAILED")
+        if not bool(getattr(preflight, "authorized", False)):
+            return preflight.to_payload()
+        if self._root_provider is None:
+            return _blocked("HOST_ROOT_PROVIDER_NOT_CONFIGURED")
+
+        root: NativeWorkspaceRootCapability | None = None
+        target: NativeOpenedTargetCapability | None = None
+        try:
+            root = self._root_provider.acquire()
+            if type(root) is not NativeWorkspaceRootCapability or not root.is_open:
+                return _blocked("HOST_ROOT_PROVIDER_INVALID")
+            target = self._opener(
+                root,
+                request.target,
+                operation=request.operation,
+                destination=ReadDestination(
+                    root.approved_workspace_root.root_id,
+                    root.approved_workspace_root.root_version,
+                    root.approved_workspace_root.root_digest,
+                ),
+                evidence=AuthorizationEvidenceBundle(),
+            )
+            if type(target) is not NativeOpenedTargetCapability or not target.is_open:
+                return _blocked("OPENED_TARGET_CAPABILITY_INVALID")
+            final_request = ProtectedReadRequest(
+                operation=request.operation,
+                target=request.target,
+                opened_target=target,
+                evidence=target.evidence,
+            )
+            decision = self._coordinator.assess(final_request)
+            if (
+                not bool(getattr(decision, "authorized", False))
+                or getattr(decision, "opened_target", None) is not target
+            ):
+                payload = decision.to_payload()
+                payload["authorized"] = False
+                return payload
+            # The exact object assessed above is the only object passed to the
+            # reader; there is no pathname resolution or second open here.
+            return self._reader(target)
+        except Exception:
+            return _blocked("ROOTED_READ_COMPOSITION_FAILED")
+        finally:
+            try:
+                if target is not None and target.is_open:
+                    target.close()
+            finally:
+                if root is not None and root.is_open:
+                    root.close()
+
+
+def _blocked(reason: str) -> dict[str, object]:
+    from iabv_v15.services.security.read_authorization import (
+        AuthorizationGate,
+        AuthorizationOutcome,
+        AuthorizationRequirement,
+        GateAssessment,
+        GateEvidenceState,
+        ReadAuthorizationDecision,
+    )
+
+    decision = ReadAuthorizationDecision(
+        ProtectedReadOperation.READ_REPO_FILE,
+        AuthorizationOutcome.DENIED,
+        reason,
+        tuple(
+            GateAssessment(gate, requirement, GateEvidenceState.EVIDENCE_NOT_ESTABLISHED)
+            for gate, requirement in (
+                (AuthorizationGate.G1, AuthorizationRequirement.G1_PRINCIPAL_MANDATE),
+                (AuthorizationGate.G2, AuthorizationRequirement.G2_VERSIONED_POLICY_FRESHNESS_REVOCATION),
+                (AuthorizationGate.G3, AuthorizationRequirement.G3_ROOT_DESTINATION_OBJECT_AND_SERVER_BINDING),
+            )
+        ),
+    )
+    return decision.to_payload()
