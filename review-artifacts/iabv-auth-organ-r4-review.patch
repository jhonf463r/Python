+    root = _root_capability(tmp_path)
+    try:
+        assert root.is_open
+        assert root.identity.object_kind.value == "DIRECTORY"
+        capability = _open_file(root, "nested/note.md")
+        try:
+            assert capability.workspace_root_identity == root.identity
+            assert capability.root_binding_state.value == "EVIDENCE_NOT_ESTABLISHED"
+            assert capability.native_identity.object_kind.value == "FILE"
+            assert read_repo_file(capability)["content"] == "rooted bytes"
+        finally:
+            capability.close()
+    finally:
+        root.close()
