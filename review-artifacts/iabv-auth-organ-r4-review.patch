+def test_composition_uses_same_opened_capability_for_decision_and_reader(tmp_path: Path) -> None:
+    (tmp_path / "note.md").write_text("same object", encoding="utf-8")
+    root = _root_capability(tmp_path)
+    assessed: list[object] = []
+    read: list[object] = []
+
+    class _TestCoordinator:
+        def assess(self, request):  # type: ignore[no-untyped-def]
+            cap = request.opened_target
+            assessed.append(cap)
+            return SimpleNamespace(
+                authorized=True,
+                opened_target=cap,
+                to_payload=lambda: {"authorized": False, "reason": "test denial"},
+            )
+
+    def reader(capability):  # type: ignore[no-untyped-def]
+        read.append(capability)
+        return read_repo_file(capability)
+
+    class _TestRootProvider:
+        def acquire(self):
+            return root
+
+    try:
+        result = ProtectedReadComposer(
+            _TestCoordinator(), _TestRootProvider(), reader=reader
+        ).read_file("note.md")
+        # First assessment is pre-open (None); second is the exact final object.
+        assert assessed[0] is None
+        assert assessed[1] is read[0]
+        assert result["content"] == "same object"
+        assert read[0].is_open is False  # composer closes it after consumption
+        assert root.is_open is False  # composer owns and closes the acquired root
+    finally:
+        if root.is_open:
+            root.close()
+
+
+def test_unconfigured_production_preflight_denies_before_provider_or_open(tmp_path: Path) -> None:
+    calls: list[str] = []
+
+    class _ForbiddenProvider:
+        def acquire(self):
+            calls.append("provider")
+            raise AssertionError("root provider must not be called")
+
+    def forbidden_opener(*_args, **_kwargs):  # type: ignore[no-untyped-def]
+        calls.append("open")
+        raise AssertionError("native opener must not be called")
+
+    def forbidden_reader(*_args, **_kwargs):  # type: ignore[no-untyped-def]
+        calls.append("reader")
+        raise AssertionError("reader must not be called")
+
+    result = ProtectedReadComposer(
+        ReadAuthorizationCoordinator.unconfigured(),
+        _ForbiddenProvider(),
+        opener=forbidden_opener,
+        reader=forbidden_reader,
+    ).read_file("anything.txt")
+
+    assert result["authorized"] is False
+    assert result["error"] == "READ_AUTHORIZATION_NOT_ESTABLISHED"
+    assert calls == []
+
