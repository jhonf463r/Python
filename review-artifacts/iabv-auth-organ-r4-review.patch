diff --git a/IABV_v1.5/src/iabv_v15/infra/mcp/audit_tools/opened_target.py b/IABV_v1.5/src/iabv_v15/infra/mcp/audit_tools/opened_target.py
new file mode 100644
index 00000000..3e3035bd
--- /dev/null
+++ b/IABV_v1.5/src/iabv_v15/infra/mcp/audit_tools/opened_target.py
@@ -0,0 +1,272 @@
+"""Internal same-handle capability for reading one already-open regular file.
+
+This module does not open paths, prove workspace containment, or authorize a
+protected read. A trusted opener would have to establish those facts after the
+G1/G2 preflight. The MCP server currently has no such providers and stays
+deny-only. Tests may use temporary files to verify that this reader consumes
+the OS object behind the handle rather than resolving its name again.
+"""
+
+from __future__ import annotations
+
+import os
+import stat
+import sys
+from typing import BinaryIO
+
+from iabv_v15.services.security.read_authorization import (
+    ApprovedWorkspaceRoot,
+    AuthorizationEvidenceBundle,
+    NativeObjectIdentity,
+    ProtectedReadOperation,
+    ReadDestination,
+    RequestedReadTarget,
+    ServerProcessIdentity,
+    TargetObjectKind,
+)
+
+_CAPABILITY_SEAL = object()
+
+
+class NativeOpenedTargetCapability:
+    """Owns a duplicate of an OS handle and its identity obtained from that handle.
+
+    Construction is intentionally private to internal code. The class is not
+    an MCP argument and its metadata alone never establishes G1/G2/G3 or root
+    containment. ``_from_open_handle`` duplicates an existing descriptor; it
+    never opens or resolves a path.
+    """
+
+    __slots__ = (
+        "_fd",
+        "_closed",
+        "operation",
+        "approved_workspace_root",
+        "workspace_root_identity",
+        "destination",
+        "requested_target",
+        "native_identity",
+        "server_process",
+        "evidence",
+        "root_binding_state",
+        "_retained_handles",
+        "_sealed",
+    )
+
+    def __init__(
+        self,
+        *,
+        fd: int,
+        operation: ProtectedReadOperation,
+        approved_workspace_root: ApprovedWorkspaceRoot,
+        destination: ReadDestination,
+        requested_target: RequestedReadTarget,
+        native_identity: NativeObjectIdentity,
+        server_process: ServerProcessIdentity,
+        evidence: AuthorizationEvidenceBundle,
+        workspace_root_identity: NativeObjectIdentity | None = None,
+        root_binding_state: object | None = None,
+        retained_handles: tuple[int, ...] = (),
+        _seal: object,
+    ) -> None:
+        if _seal is not _CAPABILITY_SEAL:
+            raise TypeError("opened-target capabilities must come from an internal open handle")
+        self._fd = fd
+        self._closed = False
+        self.operation = operation
+        self.approved_workspace_root = approved_workspace_root
+        self.workspace_root_identity = workspace_root_identity
+        self.destination = destination
+        self.requested_target = requested_target
+        self.native_identity = native_identity
+        self.server_process = server_process
+        self.evidence = evidence
+        from iabv_v15.services.security.read_authorization import GateEvidenceState
+
+        if workspace_root_identity is not None and type(workspace_root_identity) is not NativeObjectIdentity:
+            raise TypeError("workspace_root_identity must be native identity evidence")
+        if root_binding_state is None:
+            root_binding_state = GateEvidenceState.EVIDENCE_NOT_ESTABLISHED
+        if type(root_binding_state) is not GateEvidenceState:
+            raise TypeError("root_binding_state must be a GateEvidenceState")
+        self.root_binding_state = root_binding_state
+        self._retained_handles = retained_handles
+        self._sealed = True
+
+    def __setattr__(self, name: str, value: object) -> None:
+        if getattr(self, "_sealed", False):
+            raise AttributeError("opened-target capability metadata is immutable")
+        object.__setattr__(self, name, value)
+
+    @classmethod
+    def _from_open_handle(
+        cls,
+        handle: BinaryIO,
+        *,
+        operation: ProtectedReadOperation,
+        approved_workspace_root: ApprovedWorkspaceRoot,
+        destination: ReadDestination,
+        requested_target: RequestedReadTarget,
+        server_process: ServerProcessIdentity,
+        evidence: AuthorizationEvidenceBundle,
+        workspace_root_identity: NativeObjectIdentity | None = None,
+        root_binding_state: object | None = None,
+        retained_handles: tuple[int, ...] = (),
+    ) -> NativeOpenedTargetCapability:
+        """Take an existing binary handle, duplicate it, and query OS identity."""
+        if operation is not ProtectedReadOperation.READ_REPO_FILE:
+            raise ValueError("opened-file capability supports READ_REPO_FILE only")
+        if not callable(getattr(handle, "fileno", None)):
+            raise TypeError("handle must expose a native file descriptor")
+        if type(approved_workspace_root) is not ApprovedWorkspaceRoot:
+            raise TypeError("approved_workspace_root must be typed")
+        if type(destination) is not ReadDestination:
+            raise TypeError("destination must be typed")
+        if type(requested_target) is not RequestedReadTarget:
+            raise TypeError("requested_target must be typed")
+        if type(server_process) is not ServerProcessIdentity:
+            raise TypeError("server_process must be typed")
+        if type(evidence) is not AuthorizationEvidenceBundle:
+            raise TypeError("evidence must be typed")
+
+        try:
+            fd = os.dup(handle.fileno())
+        except (AttributeError, OSError, ValueError) as exc:
+            raise OSError("cannot duplicate an open target handle") from exc
+        try:
+            identity = _identity_from_open_fd(fd)
+            if identity.object_kind is not TargetObjectKind.FILE:
+                raise OSError("opened target is not a regular file")
+            return cls(
+                fd=fd,
+                operation=operation,
+                approved_workspace_root=approved_workspace_root,
+                destination=destination,
+                requested_target=requested_target,
+                native_identity=identity,
+                server_process=server_process,
+                evidence=evidence,
+                workspace_root_identity=workspace_root_identity,
+                root_binding_state=root_binding_state,
+                retained_handles=retained_handles,
+                _seal=_CAPABILITY_SEAL,
+            )
+        except Exception:
+            os.close(fd)
+            raise
+
+    @property
+    def is_open(self) -> bool:
+        return not self._closed
+
+    def read_bytes(self, max_bytes: int) -> bytes:
+        """Read from the owned handle only; never reopen the target by name."""
+        if self._closed:
+            raise OSError("opened target capability is closed")
+        if type(max_bytes) is not int or max_bytes < 0:
+            raise ValueError("max_bytes must be a non-negative integer")
+        before = _identity_from_open_fd(self._fd)
+        if before != self.native_identity:
+            raise OSError("native object identity changed on the owned handle")
+        if os.fstat(self._fd).st_size > max_bytes:
+            raise ValueError("file_too_large")
+        os.lseek(self._fd, 0, os.SEEK_SET)
+        chunks: list[bytes] = []
+        remaining = max_bytes + 1
+        while remaining:
+            chunk = os.read(self._fd, min(64 * 1024, remaining))
+            if not chunk:
+                break
+            chunks.append(chunk)
+            remaining -= len(chunk)
+        content = b"".join(chunks)
+        if len(content) > max_bytes:
+            raise ValueError("file_too_large")
+        after = _identity_from_open_fd(self._fd)
+        if after != self.native_identity:
+            raise OSError("native object identity changed during consumption")
+        return content
+
+    def close(self) -> None:
+        if not self._closed:
+            error: BaseException | None = None
+            try:
+                os.close(self._fd)
+            except BaseException as exc:  # close every retained native handle
+                error = exc
+            if self._retained_handles and sys.platform == "win32":
+                import ctypes
+
+                close_handle = ctypes.WinDLL("kernel32", use_last_error=True).CloseHandle
+                close_handle.argtypes = [ctypes.c_void_p]
+                close_handle.restype = ctypes.c_int
+                for handle in reversed(self._retained_handles):
+                    if not close_handle(ctypes.c_void_p(handle)) and error is None:
+                        error = OSError(ctypes.get_last_error(), "CloseHandle failed")
+            object.__setattr__(self, "_closed", True)
+            if error is not None:
+                raise error
+
+    def __enter__(self) -> NativeOpenedTargetCapability:
+        if self._closed:
+            raise OSError("opened target capability is closed")
+        return self
+
+    def __exit__(self, *_exc: object) -> None:
+        self.close()
+
+
+def _identity_from_open_fd(fd: int) -> NativeObjectIdentity:
+    """Read stable object identity from the open descriptor, not its pathname."""
+    info = os.fstat(fd)
+    if stat.S_ISREG(info.st_mode):
+        kind = TargetObjectKind.FILE
+    elif stat.S_ISDIR(info.st_mode):
+        kind = TargetObjectKind.DIRECTORY
+    else:
+        kind = TargetObjectKind.OTHER
+
+    if sys.platform == "win32":
+        import ctypes
+        import msvcrt
+
+        class _FileIdInfo(ctypes.Structure):
+            _fields_ = [
+                ("VolumeSerialNumber", ctypes.c_ulonglong),
+                ("FileId", ctypes.c_ubyte * 16),
+            ]
+
+        class _FileStandardInfo(ctypes.Structure):
+            _fields_ = [
+                ("AllocationSize", ctypes.c_longlong),
+                ("EndOfFile", ctypes.c_longlong),
+                ("NumberOfLinks", ctypes.c_ulong),
+                ("DeletePending", ctypes.c_ubyte),
+                ("Directory", ctypes.c_ubyte),
+            ]
+
+        handle = ctypes.c_void_p(msvcrt.get_osfhandle(fd))
+        kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
+        query = kernel32.GetFileInformationByHandleEx
+        query.argtypes = [ctypes.c_void_p, ctypes.c_int, ctypes.c_void_p, ctypes.c_ulong]
+        query.restype = ctypes.c_int
+
+        file_id = _FileIdInfo()
+        if not query(handle, 18, ctypes.byref(file_id), ctypes.sizeof(file_id)):
+            raise OSError(ctypes.get_last_error(), "FileIdInfo query failed")
+        standard = _FileStandardInfo()
+        if not query(handle, 1, ctypes.byref(standard), ctypes.sizeof(standard)):
+            raise OSError(ctypes.get_last_error(), "FileStandardInfo query failed")
+        native_kind = TargetObjectKind.DIRECTORY if standard.Directory else kind
+        return NativeObjectIdentity(
+            volume_serial=int(file_id.VolumeSerialNumber),
+            file_id=bytes(file_id.FileId),
+            object_kind=native_kind,
+        )
+
+    file_id = int(info.st_ino).to_bytes(16, "little", signed=False)
+    return NativeObjectIdentity(
+        volume_serial=int(info.st_dev),
+        file_id=file_id,
+        object_kind=kind,
+    )
