+def test_opened_component_and_parent_handles_close_after_reparse_denial(
+    tmp_path: Path, monkeypatch
+) -> None:  # type: ignore[no-untyped-def]
+    root = _root_capability(tmp_path)
+    fake_component_handle = 0x765432
+    closed: list[int] = []
+    original_query = rooted_open._WindowsNative.query_identity
+    original_close = rooted_open._WindowsNative.close_handle
+
+    def query(self, handle: int):  # type: ignore[no-untyped-def]
+        if handle == fake_component_handle:
+            return (
+                NativeObjectIdentity(1, b"component-id", TargetObjectKind.FILE),
+                SimpleNamespace(Directory=0, NumberOfLinks=1),
+                SimpleNamespace(FileAttributes=rooted_open._FILE_ATTRIBUTE_REPARSE_POINT),
+            )
+        return original_query(self, handle)
+
+    def close(self, handle: int) -> None:
+        closed.append(handle)
+        if handle != fake_component_handle:
+            original_close(self, handle)
+
+    monkeypatch.setattr(
+        rooted_open._WindowsNative,
+        "open_component",
+        lambda *_args, **_kwargs: fake_component_handle,
+    )
+    monkeypatch.setattr(rooted_open._WindowsNative, "query_identity", query)
+    monkeypatch.setattr(rooted_open._WindowsNative, "close_handle", close)
+    try:
+        with pytest.raises(OSError, match="reparse points are forbidden"):
+            _open_file(root, "blocked.txt")
+        assert fake_component_handle in closed
+        assert len(closed) == 2  # rejected component plus duplicated root handle
+    finally:
+        root.close()
+
