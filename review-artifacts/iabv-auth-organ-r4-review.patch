+++ b/IABV_v1.5/src/iabv_v15/infra/mcp/audit_tools/rooted_open.py
@@ -0,0 +1,431 @@
+"""Fail-closed Windows component opener rooted at an already-open directory.
+
+There is deliberately no production root provider in this module or in the
+MCP bootstrap. A future host-owned provider must supply a live directory
+handle that it opened without delete sharing and bind its provenance to the
+approved workspace and server. This module only consumes that capability.
+"""
+
+from __future__ import annotations
+
+import ctypes
+import os
+import re
+import sys
+from ctypes import wintypes
+from typing import BinaryIO
+
+from iabv_v15.infra.mcp.audit_tools.opened_target import NativeOpenedTargetCapability
+from iabv_v15.services.security.read_authorization import (
+    ApprovedWorkspaceRoot,
+    AuthorizationEvidenceBundle,
+    GateEvidenceState,
+    NativeObjectIdentity,
+    ProtectedReadOperation,
+    ReadDestination,
+    RequestedReadTarget,
+    ServerProcessIdentity,
+    TargetObjectKind,
+)
+
+_ROOT_ISSUER_SEAL = object()
+_FILE_OPEN = 0x00000001
+_FILE_OPEN_REPARSE_POINT = 0x00200000
+_FILE_SYNCHRONOUS_IO_NONALERT = 0x00000020
+_OBJ_CASE_INSENSITIVE = 0x00000040
+_FILE_READ_DATA = 0x00000001
+_FILE_READ_ATTRIBUTES = 0x00000080
+_FILE_TRAVERSE = 0x00000020
+_SYNCHRONIZE = 0x00100000
+_FILE_SHARE_READ = 0x00000001
+_FILE_SHARE_WRITE = 0x00000002
+_FILE_ATTRIBUTE_REPARSE_POINT = 0x00000400
+_FILE_INFO_STANDARD = 1
+_FILE_INFO_ATTRIBUTE_TAG = 9
+_FILE_INFO_ID = 18
+_INVALID_COMPONENT_CHARS = re.compile(r'[<>:"/\\|?*\x00-\x1f]')
+_DOS_DEVICE_NAME = re.compile(
+    r"(?i)^(?:CON|PRN|AUX|NUL|COM[1-9]|LPT[1-9])(?:\..*)?$"
+)
+
+
+class _UnicodeString(ctypes.Structure):
+    _fields_ = [
+        ("Length", wintypes.USHORT),
+        ("MaximumLength", wintypes.USHORT),
+        ("Buffer", ctypes.c_void_p),
+    ]
+
+
+class _ObjectAttributes(ctypes.Structure):
+    _fields_ = [
+        ("Length", wintypes.ULONG),
+        ("RootDirectory", wintypes.HANDLE),
+        ("ObjectName", ctypes.POINTER(_UnicodeString)),
+        ("Attributes", wintypes.ULONG),
+        ("SecurityDescriptor", ctypes.c_void_p),
+        ("SecurityQualityOfService", ctypes.c_void_p),
+    ]
+
+
+class _IoStatusBlock(ctypes.Structure):
+    _fields_ = [("Status", ctypes.c_void_p), ("Information", ctypes.c_size_t)]
+
+
+class _FileIdInfo(ctypes.Structure):
+    _fields_ = [("VolumeSerialNumber", ctypes.c_ulonglong), ("FileId", ctypes.c_ubyte * 16)]
+
+
+class _FileStandardInfo(ctypes.Structure):
+    _fields_ = [
+        ("AllocationSize", ctypes.c_longlong),
+        ("EndOfFile", ctypes.c_longlong),
+        ("NumberOfLinks", wintypes.DWORD),
+        ("DeletePending", ctypes.c_ubyte),
+        ("Directory", ctypes.c_ubyte),
+    ]
+
+
+class _FileAttributeTagInfo(ctypes.Structure):
+    _fields_ = [("FileAttributes", wintypes.DWORD), ("ReparseTag", wintypes.DWORD)]
+
+
+class NativeWorkspaceRootCapability:
+    """Owns a duplicate root handle and provider-bound root identity.
+
+    The private issuer seal prevents ordinary callers from manufacturing this
+    capability through the public API. It is not a security boundary against
+    arbitrary code already executing in this Python process.
+    """
+
+    __slots__ = (
+        "_handle",
+        "_closed",
+        "approved_workspace_root",
+        "identity",
+        "provider_id",
+        "workspace_context_id",
+        "server_process",
+        "mutation_sharing_denied",
+        "_sealed",
+    )
+
+    def __init__(
+        self,
+        *,
+        handle: int,
+        approved_workspace_root: ApprovedWorkspaceRoot,
+        identity: NativeObjectIdentity,
+        provider_id: str,
+        workspace_context_id: str,
+        server_process: ServerProcessIdentity,
+        mutation_sharing_denied: bool,
+        _issuer_seal: object,
+    ) -> None:
+        if _issuer_seal is not _ROOT_ISSUER_SEAL:
+            raise TypeError("workspace roots must be issued by the host-owned provider")
+        if not mutation_sharing_denied:
+            raise ValueError("root handle must deny write and delete sharing while in use")
+        if type(approved_workspace_root) is not ApprovedWorkspaceRoot:
+            raise TypeError("approved_workspace_root must be typed")
+        if type(identity) is not NativeObjectIdentity or identity.object_kind is not TargetObjectKind.DIRECTORY:
+            raise TypeError("identity must describe a native directory handle")
+        if type(server_process) is not ServerProcessIdentity:
+            raise TypeError("server_process must be typed")
+        if any(type(value) is not str or not value for value in (provider_id, workspace_context_id)):
+            raise ValueError("provider and workspace context identities must be non-empty")
+        self._handle = handle
+        self._closed = False
+        self.approved_workspace_root = approved_workspace_root
+        self.identity = identity
+        self.provider_id = provider_id
+        self.workspace_context_id = workspace_context_id
+        self.server_process = server_process
+        self.mutation_sharing_denied = mutation_sharing_denied
+        self._sealed = True
+
+    def __setattr__(self, name: str, value: object) -> None:
+        if getattr(self, "_sealed", False):
+            raise AttributeError("workspace-root capability metadata is immutable")
+        object.__setattr__(self, name, value)
+
+    @classmethod
+    def _from_host_provider_handle(
+        cls,
+        handle: int,
+        *,
+        approved_workspace_root: ApprovedWorkspaceRoot,
+        provider_id: str,
+        workspace_context_id: str,
+        server_process: ServerProcessIdentity,
+        mutation_sharing_denied: bool,
+        _issuer_seal: object,
+    ) -> NativeWorkspaceRootCapability:
+        if _issuer_seal is not _ROOT_ISSUER_SEAL:
+            raise TypeError("workspace roots must be issued by the host-owned provider")
+        native = _WindowsNative()
+        duplicate = native.duplicate_handle(handle)
+        try:
+            identity, standard, attributes = native.query_identity(duplicate)
+            if not standard.Directory:
+                raise OSError("workspace root handle is not a directory")
+            if attributes.FileAttributes & _FILE_ATTRIBUTE_REPARSE_POINT:
+                raise OSError("workspace root cannot be a reparse point")
+            return cls(
+                handle=duplicate,
+                approved_workspace_root=approved_workspace_root,
+                identity=identity,
+                provider_id=provider_id,
+                workspace_context_id=workspace_context_id,
+                server_process=server_process,
+                mutation_sharing_denied=mutation_sharing_denied,
+                _issuer_seal=_issuer_seal,
+            )
+        except Exception:
+            native.close_handle(duplicate)
+            raise
+
+    @property
+    def is_open(self) -> bool:
+        return not self._closed
+
+    def close(self) -> None:
+        if self._closed:
+            return
+        _WindowsNative().close_handle(self._handle)
+        object.__setattr__(self, "_closed", True)
+
+
+class _WindowsNative:
+    """Small, explicitly typed binding to documented user-mode Winternl APIs."""
+
+    def __init__(self) -> None:
+        if sys.platform != "win32":
+            raise OSError("root-relative native opens are Windows-only")
+        self.kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
+        self.ntdll = ctypes.WinDLL("ntdll")
+        self._set_prototypes()
+
+    def _set_prototypes(self) -> None:
+        self.kernel32.GetCurrentProcess.argtypes = []
+        self.kernel32.GetCurrentProcess.restype = wintypes.HANDLE
+        self.kernel32.DuplicateHandle.argtypes = [
+            wintypes.HANDLE, wintypes.HANDLE, wintypes.HANDLE,
+            ctypes.POINTER(wintypes.HANDLE), wintypes.DWORD,
+            wintypes.BOOL, wintypes.DWORD,
+        ]
+        self.kernel32.DuplicateHandle.restype = wintypes.BOOL
+        self.kernel32.CloseHandle.argtypes = [wintypes.HANDLE]
+        self.kernel32.CloseHandle.restype = wintypes.BOOL
+        self.kernel32.GetFileInformationByHandleEx.argtypes = [
+            wintypes.HANDLE, ctypes.c_int, ctypes.c_void_p, wintypes.DWORD,
+        ]
+        self.kernel32.GetFileInformationByHandleEx.restype = wintypes.BOOL
+        self.ntdll.NtCreateFile.argtypes = [
+            ctypes.POINTER(wintypes.HANDLE), wintypes.DWORD,
+            ctypes.POINTER(_ObjectAttributes), ctypes.POINTER(_IoStatusBlock),
+            ctypes.c_void_p, wintypes.ULONG, wintypes.ULONG, wintypes.ULONG,
+            wintypes.ULONG, ctypes.c_void_p, wintypes.ULONG,
+        ]
+        self.ntdll.NtCreateFile.restype = ctypes.c_long
+
+    def duplicate_handle(self, handle: int) -> int:
+        duplicate = wintypes.HANDLE()
+        current = self.kernel32.GetCurrentProcess()
+        if not self.kernel32.DuplicateHandle(
+            current, wintypes.HANDLE(handle), current, ctypes.byref(duplicate),
+            0, False, 0x00000002,  # DUPLICATE_SAME_ACCESS
+        ):
+            raise ctypes.WinError(ctypes.get_last_error())
+        return int(duplicate.value)
+
+    def close_handle(self, handle: int) -> None:
+        if not self.kernel32.CloseHandle(wintypes.HANDLE(handle)):
+            raise ctypes.WinError(ctypes.get_last_error())
+
+    def query_identity(
+        self, handle: int
+    ) -> tuple[NativeObjectIdentity, _FileStandardInfo, _FileAttributeTagInfo]:
+        file_id = _FileIdInfo()
+        standard = _FileStandardInfo()
+        attributes = _FileAttributeTagInfo()
+        for info_class, instance in (
+            (_FILE_INFO_ID, file_id),
+            (_FILE_INFO_STANDARD, standard),
+            (_FILE_INFO_ATTRIBUTE_TAG, attributes),
+        ):
+            if not self.kernel32.GetFileInformationByHandleEx(
+                wintypes.HANDLE(handle), info_class, ctypes.byref(instance), ctypes.sizeof(instance)
+            ):
+                raise ctypes.WinError(ctypes.get_last_error())
+        kind = TargetObjectKind.DIRECTORY if standard.Directory else TargetObjectKind.FILE
+        identity = NativeObjectIdentity(
+            volume_serial=int(file_id.VolumeSerialNumber),
+            file_id=bytes(file_id.FileId),
+            object_kind=kind,
+        )
+        return identity, standard, attributes
+
+    def open_component(self, parent_handle: int, component: str, *, final: bool) -> int:
+        encoded = ctypes.create_unicode_buffer(component)
+        byte_length = len(component.encode("utf-16-le"))
+        name = _UnicodeString(byte_length, byte_length, ctypes.cast(encoded, ctypes.c_void_p))
+        attributes = _ObjectAttributes(
+            ctypes.sizeof(_ObjectAttributes),
+            wintypes.HANDLE(parent_handle),
+            ctypes.pointer(name),
+            _OBJ_CASE_INSENSITIVE,
+            None,
+            None,
+        )
+        io_status = _IoStatusBlock()
+        result = wintypes.HANDLE()
+        status = int(
+            self.ntdll.NtCreateFile(
+                ctypes.byref(result),
+                (_FILE_READ_DATA if final else _FILE_TRAVERSE)
+                | _FILE_READ_ATTRIBUTES
+                | _SYNCHRONIZE,
+                ctypes.byref(attributes),
+                ctypes.byref(io_status),
+                None,
+                0,
+                _FILE_SHARE_READ,  # deny concurrent write and delete opens
+                _FILE_OPEN,
+                _FILE_OPEN_REPARSE_POINT | _FILE_SYNCHRONOUS_IO_NONALERT,
+                None,
+                0,
+            )
+        )
+        if status < 0:
+            raise OSError(f"NtCreateFile failed with NTSTATUS 0x{status & 0xffffffff:08X}")
+        if not result.value:
+            raise OSError("NtCreateFile succeeded without returning a handle")
+        return int(result.value)
+
+
+def _validated_components(raw_target: object) -> tuple[str, ...]:
+    if type(raw_target) is not str or not raw_target:
+        raise ValueError("target must be a non-empty relative string")
+    if raw_target.startswith(("/", "\\")) or re.match(r"(?i)^[a-z]:", raw_target):
+        raise ValueError("absolute target paths are forbidden")
+    parts = tuple(raw_target.replace("\\", "/").split("/"))
+    if any(
+        not part
+        or part in (".", "..")
+        or part.endswith((".", " "))
+        or _INVALID_COMPONENT_CHARS.search(part)
+        or _DOS_DEVICE_NAME.match(part)
+        for part in parts
+    ):
+        raise ValueError("target contains an invalid or non-component path element")
+    return parts
+
+
+def open_target_relative_to_root(
+    root: NativeWorkspaceRootCapability,
+    target: RequestedReadTarget,
+    *,
+    operation: ProtectedReadOperation,
+    destination: ReadDestination,
+    evidence: AuthorizationEvidenceBundle,
+) -> NativeOpenedTargetCapability:
+    """Open every name relative to its validated parent handle, then bind final.
+
+    Every component is opened with FILE_OPEN_REPARSE_POINT and inspected from
+    that handle. Intermediate handles omit FILE_SHARE_DELETE and stay alive
+    through reader consumption, preventing concurrent rename while held on
+    filesystems that honor Windows share-access semantics.
+    """
+    if type(root) is not NativeWorkspaceRootCapability or not root.is_open:
+        raise OSError("trusted workspace root capability is unavailable")
+    if operation is not ProtectedReadOperation.READ_REPO_FILE:
+        raise ValueError("rooted opener supports READ_REPO_FILE only")
+    if type(target) is not RequestedReadTarget:
+        raise TypeError("target must be a RequestedReadTarget")
+    if type(destination) is not ReadDestination or type(evidence) is not AuthorizationEvidenceBundle:
+        raise TypeError("destination and evidence must be typed")
+    components = _validated_components(target.raw_value)
+    native = _WindowsNative()
+    observed_root, root_standard, root_attributes = native.query_identity(root._handle)
+    if (
+        observed_root != root.identity
+        or not root_standard.Directory
+        or root_attributes.FileAttributes & _FILE_ATTRIBUTE_REPARSE_POINT
+        or not root.mutation_sharing_denied
+    ):
+        raise OSError("root handle binding is invalid")
+
+    retained: list[int] = [native.duplicate_handle(root._handle)]
+    parent = retained[0]
+    final_handle: int | None = None
+    try:
+        for index, component in enumerate(components):
+            final = index == len(components) - 1
+            opened = native.open_component(parent, component, final=final)
+            try:
+                identity, standard, attributes = native.query_identity(opened)
+                if attributes.FileAttributes & _FILE_ATTRIBUTE_REPARSE_POINT:
+                    raise OSError("reparse points are forbidden")
+                if identity.volume_serial != root.identity.volume_serial:
+                    raise OSError("component crossed the workspace root volume")
+                if final:
+                    if standard.Directory:
+                        raise OSError("target is not a regular file")
+                    if standard.NumberOfLinks != 1:
+                        raise OSError("target hard links are forbidden")
+                    final_handle = opened
+                    break
+                if not standard.Directory:
+                    raise OSError("intermediate component is not a directory")
+                retained.append(opened)
+                parent = opened
+            except Exception:
+                if opened != final_handle and opened not in retained:
+                    native.close_handle(opened)
+                raise
+
+        assert final_handle is not None
+        import msvcrt
+
+        fd = msvcrt.open_osfhandle(final_handle, os.O_RDONLY | os.O_BINARY)
+        final_handle = None  # ownership transferred to the CRT descriptor
+        source: BinaryIO = os.fdopen(fd, "rb")
+        try:
+            return NativeOpenedTargetCapability._from_open_handle(
+                source,
+                operation=operation,
+                approved_workspace_root=root.approved_workspace_root,
+                destination=destination,
+                requested_target=target,
+                server_process=root.server_process,
+                evidence=evidence,
+                workspace_root_identity=root.identity,
+                # Native relative traversal was observed, but no production
+                # host-owned root issuer establishes the authority of this
+                # root. Do not represent the synthetic binding as G3 evidence.
+                root_binding_state=GateEvidenceState.EVIDENCE_NOT_ESTABLISHED,
+                retained_handles=tuple(retained),
+            )
+        except Exception:
+            for handle in reversed(retained):
+                try:
+                    native.close_handle(handle)
+                except OSError:
+                    pass
+            retained.clear()
+            raise
+        finally:
+            source.close()
+    except Exception:
+        if final_handle is not None:
+            try:
+                native.close_handle(final_handle)
+            except OSError:
+                pass
+        for handle in reversed(retained):
+            try:
+                native.close_handle(handle)
+            except OSError:
+                pass
+        raise
diff --git a/IABV_v1.5/src/iabv_v15/services/security/read_authorization.py b/IABV_v1.5/src/iabv_v15/services/security/read_authorization.py
new file mode 100644
index 00000000..ef0726bf
--- /dev/null
+++ b/IABV_v1.5/src/iabv_v15/services/security/read_authorization.py
@@ -0,0 +1,275 @@
+"""Typed, deny-only contract for protected repository observations.
+
+This module intentionally has no evidence providers and no authorized result.
+Its data classes describe bindings that a future governed implementation
+would have to prove; caller-supplied values are never trusted as proof.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from enum import Enum
+from typing import Protocol
+
+
+class ProtectedReadOperation(str, Enum):
+    READ_REPO_FILE = "read_repo_file"
+    LIST_REPO_DIRECTORY = "list_repo_directory"
+    GIT_STATUS_AND_LOG = "git_status_and_log"
+
+
+class AuthorizationGate(str, Enum):
+    G1 = "G1"
+    G2 = "G2"
+    G3 = "G3"
+
+
+class GateEvidenceState(str, Enum):
+    CONFIGURATION_ABSENT = "CONFIGURATION_ABSENT"
+    EVIDENCE_NOT_ESTABLISHED = "EVIDENCE_NOT_ESTABLISHED"
+    EVIDENCE_INVALID = "EVIDENCE_INVALID"
+    EXPIRED = "EXPIRED"
+    REVOKED = "REVOKED"
+
+
+class AuthorizationRequirement(str, Enum):
+    G1_PRINCIPAL_MANDATE = "G1_PRINCIPAL_MANDATE"
+    G2_VERSIONED_POLICY_FRESHNESS_REVOCATION = "G2_VERSIONED_POLICY_FRESHNESS_REVOCATION"
+    G3_ROOT_DESTINATION_OBJECT_AND_SERVER_BINDING = "G3_ROOT_DESTINATION_OBJECT_AND_SERVER_BINDING"
+
+
+class AuthorizationOutcome(str, Enum):
+    DENIED = "DENIED"
+    ERROR = "ERROR"
+
+
+class TargetObjectKind(str, Enum):
+    FILE = "FILE"
+    DIRECTORY = "DIRECTORY"
+    OTHER = "OTHER"
+
+
+@dataclass(frozen=True, slots=True)
+class NativeObjectIdentity:
+    """Identity read from an open OS handle, never inferred from a path string."""
+
+    volume_serial: int
+    file_id: bytes
+    object_kind: TargetObjectKind
+
+    def __post_init__(self) -> None:
+        if type(self.volume_serial) is not int or self.volume_serial < 0:
+            raise ValueError("volume_serial must be a non-negative integer")
+        if type(self.file_id) is not bytes or not self.file_id:
+            raise ValueError("file_id must be non-empty bytes obtained from the OS")
+        if type(self.object_kind) is not TargetObjectKind:
+            raise TypeError("object_kind must be a TargetObjectKind")
+
+
+@dataclass(frozen=True, slots=True)
+class PrincipalMandateEvidence:
+    """Untrusted shape for a principal and its mandate; not evidence by itself."""
+
+    principal_id: str
+    mandate_id: str
+    mandate_version: str
+    issuer_id: str
+
+
+@dataclass(frozen=True, slots=True)
+class PolicyEvidence:
+    """Immutable policy identity and version expected by a future verifier."""
+
+    policy_id: str
+    policy_version: str
+    policy_digest: str
+
+
+@dataclass(frozen=True, slots=True)
+class ApprovedWorkspaceRoot:
+    """Root binding; the path is descriptive and is never resolved here."""
+
+    root_id: str
+    root_version: str
+    root_digest: str
+
+
+@dataclass(frozen=True, slots=True)
+class RequestedReadTarget:
+    """Raw target supplied to a handler, before any path resolution."""
+
+    raw_value: object
+
+
+@dataclass(frozen=True, slots=True)
+class ReadDestination:
+    """Destination identity expected in an authorization binding."""
+
+    destination_id: str
+    destination_version: str
+    destination_digest: str
+
+
+@dataclass(frozen=True, slots=True)
+class ReadTargetBinding:
+    """A future proof binding an approved root to an exact requested target."""
+
+    root_id: str
+    root_version: str
+    target_digest: str
+
+
+@dataclass(frozen=True, slots=True)
+class OpenObjectCapability:
+    """Identity of an already-open object a reader would consume directly."""
+
+    object_id: str
+    object_version: str
+    handle_identity: str
+
+
+@dataclass(frozen=True, slots=True)
+class ServerProcessIdentity:
+    """Server/process identity that a future decision must bind."""
+
+    server_id: str
+    process_id: int
+    executable_digest: str
+
+
+class OpenedTargetCapability(Protocol):
+    """Internal handle capability; its metadata is not authorization evidence."""
+
+    operation: ProtectedReadOperation
+    approved_workspace_root: ApprovedWorkspaceRoot
+    workspace_root_identity: NativeObjectIdentity | None
+    destination: ReadDestination
+    requested_target: RequestedReadTarget
+    native_identity: NativeObjectIdentity
+    server_process: ServerProcessIdentity
+    evidence: AuthorizationEvidenceBundle
+    root_binding_state: GateEvidenceState
+
+    @property
+    def is_open(self) -> bool: ...
+
+    def read_bytes(self, max_bytes: int) -> bytes: ...
+
+
+@dataclass(frozen=True, slots=True)
+class AuthorizationEvidenceBundle:
+    """Caller-shaped evidence fields, explicitly ignored by this deny-only gate."""
+
+    principal_mandate: PrincipalMandateEvidence | None = None
+    policy: PolicyEvidence | None = None
+    workspace_root: ApprovedWorkspaceRoot | None = None
+    destination: ReadDestination | None = None
+    target_binding: ReadTargetBinding | None = None
+    open_object: OpenObjectCapability | None = None
+    server_process: ServerProcessIdentity | None = None
+
+
+@dataclass(frozen=True, slots=True)
+class ProtectedReadRequest:
+    operation: ProtectedReadOperation
+    target: RequestedReadTarget | None = None
+    opened_target: OpenedTargetCapability | None = None
+    evidence: AuthorizationEvidenceBundle = field(default_factory=AuthorizationEvidenceBundle)
+
+
+@dataclass(frozen=True, slots=True)
+class GateAssessment:
+    gate: AuthorizationGate
+    requirement: AuthorizationRequirement
+    state: GateEvidenceState
+
+
+@dataclass(frozen=True, slots=True)
+class ReadAuthorizationDecision:
+    operation: ProtectedReadOperation | None
+    outcome: AuthorizationOutcome
+    reason: str
+    assessments: tuple[GateAssessment, ...]
+    opened_target: OpenedTargetCapability | None = None
+
+    def __post_init__(self) -> None:
+        if type(self.outcome) is not AuthorizationOutcome:
+            raise TypeError("outcome must be an AuthorizationOutcome")
+        if type(self.reason) is not str or not self.reason:
+            raise ValueError("reason must be a non-empty string")
+        if type(self.assessments) is not tuple:
+            raise TypeError("assessments must be a tuple")
+        if self.outcome in (AuthorizationOutcome.DENIED, AuthorizationOutcome.ERROR):
+            gates = tuple(item.gate for item in self.assessments)
+            if gates != (AuthorizationGate.G1, AuthorizationGate.G2, AuthorizationGate.G3):
+                raise ValueError("denial/error must report G1, G2, and G3 exactly once in order")
+
+    @property
+    def authorized(self) -> bool:
+        """No constructor-controlled or positive authorization state exists."""
+        return False
+
+    @property
+    def missing_requirements(self) -> tuple[GateAssessment, ...]:
+        return self.assessments
+
+    def to_payload(self) -> dict[str, object]:
+        return {
+            "authorized": False,
+            "decision": self.outcome.value,
+            "error": "READ_AUTHORIZATION_INVALID_REQUEST" if self.outcome is AuthorizationOutcome.ERROR else "READ_AUTHORIZATION_NOT_ESTABLISHED",
+            "reason": self.reason,
+            "operation": self.operation.value if self.operation is not None else None,
+            "missing_requirements": [
+                {"gate": item.gate.value, "requirement": item.requirement.value, "state": item.state.value}
+                for item in self.assessments
+            ],
+        }
+
+
+_GATE_REQUIREMENTS = (
+    (AuthorizationGate.G1, AuthorizationRequirement.G1_PRINCIPAL_MANDATE),
+    (AuthorizationGate.G2, AuthorizationRequirement.G2_VERSIONED_POLICY_FRESHNESS_REVOCATION),
+    (AuthorizationGate.G3, AuthorizationRequirement.G3_ROOT_DESTINATION_OBJECT_AND_SERVER_BINDING),
+)
+
+
+class ReadAuthorizationCoordinator:
+    """Fixed unconfigured coordinator; no provider or positive path is exposed."""
+
+    __slots__ = ()
+
+    @classmethod
+    def unconfigured(cls) -> ReadAuthorizationCoordinator:
+        return cls()
+
+    def assess(self, request: ProtectedReadRequest) -> ReadAuthorizationDecision:
+        if type(request) is not ProtectedReadRequest or type(request.operation) is not ProtectedReadOperation:
+            return self._decision(None, AuthorizationOutcome.ERROR, GateEvidenceState.EVIDENCE_INVALID, "INVALID_READ_AUTHORIZATION_REQUEST")
+        if request.target is not None and type(request.target) is not RequestedReadTarget:
+            return self._decision(request.operation, AuthorizationOutcome.ERROR, GateEvidenceState.EVIDENCE_INVALID, "INVALID_READ_AUTHORIZATION_TARGET")
+        # Neither caller-shaped evidence nor a container can configure this coordinator.
+        return self._decision(
+            request.operation,
+            AuthorizationOutcome.DENIED,
+            GateEvidenceState.CONFIGURATION_ABSENT,
+            "G1_G2_G3_NOT_ESTABLISHED",
+            opened_target=request.opened_target,
+        )
+
+    @staticmethod
+    def _decision(
+        operation: ProtectedReadOperation | None,
+        outcome: AuthorizationOutcome,
+        state: GateEvidenceState,
+        reason: str,
+        *,
+        opened_target: OpenedTargetCapability | None = None,
+    ) -> ReadAuthorizationDecision:
+        return ReadAuthorizationDecision(
+            operation=operation,
+            outcome=outcome,
+            reason=reason,
+            assessments=tuple(GateAssessment(gate, requirement, state) for gate, requirement in _GATE_REQUIREMENTS),
+            opened_target=opened_target,
+        )
diff --git a/IABV_v1.5/tests/test_read_authorization.py b/IABV_v1.5/tests/test_read_authorization.py
new file mode 100644
index 00000000..ff849b21
--- /dev/null
+++ b/IABV_v1.5/tests/test_read_authorization.py
@@ -0,0 +1,135 @@
+from __future__ import annotations
+
+from dataclasses import fields
+
+from iabv_v15.services.security.read_authorization import (
+    ApprovedWorkspaceRoot,
+    AuthorizationEvidenceBundle,
+    AuthorizationGate,
+    AuthorizationOutcome,
+    AuthorizationRequirement,
+    GateAssessment,
+    GateEvidenceState,
+    OpenObjectCapability,
+    PolicyEvidence,
+    PrincipalMandateEvidence,
+    ProtectedReadOperation,
+    ProtectedReadRequest,
+    ReadAuthorizationCoordinator,
+    ReadAuthorizationDecision,
+    ReadDestination,
+    ReadTargetBinding,
+    RequestedReadTarget,
+    ServerProcessIdentity,
+)
+
+
+def test_unconfigured_coordinator_denies_each_gate_independently() -> None:
+    decision = ReadAuthorizationCoordinator.unconfigured().assess(
+        ProtectedReadRequest(ProtectedReadOperation.READ_REPO_FILE)
+    )
+
+    assert decision.outcome is AuthorizationOutcome.DENIED
+    assert decision.authorized is False
+    assert [(item.gate, item.state) for item in decision.assessments] == [
+        (AuthorizationGate.G1, GateEvidenceState.CONFIGURATION_ABSENT),
+        (AuthorizationGate.G2, GateEvidenceState.CONFIGURATION_ABSENT),
+        (AuthorizationGate.G3, GateEvidenceState.CONFIGURATION_ABSENT),
+    ]
+    assert [item.requirement for item in decision.assessments] == [
+        AuthorizationRequirement.G1_PRINCIPAL_MANDATE,
+        AuthorizationRequirement.G2_VERSIONED_POLICY_FRESHNESS_REVOCATION,
+        AuthorizationRequirement.G3_ROOT_DESTINATION_OBJECT_AND_SERVER_BINDING,
+    ]
+
+
+def test_gate_states_keep_absent_invalid_expired_and_revoked_distinct() -> None:
+    states = (
+        GateEvidenceState.CONFIGURATION_ABSENT,
+        GateEvidenceState.EVIDENCE_NOT_ESTABLISHED,
+        GateEvidenceState.EVIDENCE_INVALID,
+        GateEvidenceState.EXPIRED,
+        GateEvidenceState.REVOKED,
+    )
+    assert len(set(states)) == 5
+
+    assessments = (
+        GateAssessment(AuthorizationGate.G1, AuthorizationRequirement.G1_PRINCIPAL_MANDATE, GateEvidenceState.REVOKED),
+        GateAssessment(AuthorizationGate.G2, AuthorizationRequirement.G2_VERSIONED_POLICY_FRESHNESS_REVOCATION, GateEvidenceState.EXPIRED),
+        GateAssessment(AuthorizationGate.G3, AuthorizationRequirement.G3_ROOT_DESTINATION_OBJECT_AND_SERVER_BINDING, GateEvidenceState.EVIDENCE_NOT_ESTABLISHED),
+    )
+    decision = ReadAuthorizationDecision(
+        ProtectedReadOperation.READ_REPO_FILE,
+        AuthorizationOutcome.DENIED,
+        "gate evidence unavailable",
+        assessments,
+    )
+    assert [item["state"] for item in decision.to_payload()["missing_requirements"]] == [
+        "REVOKED",
+        "EXPIRED",
+        "EVIDENCE_NOT_ESTABLISHED",
+    ]
+
+
+def test_authorization_outcome_has_no_positive_member_and_payload_is_fail_closed() -> None:
+    assert not hasattr(AuthorizationOutcome, "AUTHORIZED")
+    decision = ReadAuthorizationCoordinator.unconfigured().assess(
+        ProtectedReadRequest(ProtectedReadOperation.LIST_REPO_DIRECTORY)
+    )
+    payload = decision.to_payload()
+    assert payload["authorized"] is False
+    assert payload["decision"] == "DENIED"
+    assert payload["error"] == "READ_AUTHORIZATION_NOT_ESTABLISHED"
+    assert payload["operation"] == "list_repo_directory"
+
+
+def test_caller_supplied_complete_synthetic_evidence_does_not_authorize() -> None:
+    evidence = AuthorizationEvidenceBundle(
+        principal_mandate=PrincipalMandateEvidence("owner", "mandate", "v1", "issuer"),
+        policy=PolicyEvidence("policy", "v1", "digest"),
+        workspace_root=ApprovedWorkspaceRoot("root", "v1", "digest"),
+        destination=ReadDestination("workspace", "v1", "destination-digest"),
+        target_binding=ReadTargetBinding("root", "v1", "target-digest"),
+        open_object=OpenObjectCapability("object", "v1", "handle"),
+        server_process=ServerProcessIdentity("server", 100, "exe-digest"),
+    )
+    request = ProtectedReadRequest(
+        ProtectedReadOperation.READ_REPO_FILE,
+        RequestedReadTarget("docs/a.md"),
+        evidence,
+    )
+
+    decision = ReadAuthorizationCoordinator.unconfigured().assess(request)
+
+    assert decision.outcome is AuthorizationOutcome.DENIED
+    assert decision.authorized is False
+    assert all(item.state is GateEvidenceState.CONFIGURATION_ABSENT for item in decision.assessments)
+
+
+def test_malformed_request_is_typed_error_and_cannot_claim_authorized() -> None:
+    decision = ReadAuthorizationCoordinator.unconfigured().assess(object())  # type: ignore[arg-type]
+
+    assert decision.outcome is AuthorizationOutcome.ERROR
+    assert decision.authorized is False
+    payload = decision.to_payload()
+    assert payload["error"] == "READ_AUTHORIZATION_INVALID_REQUEST"
+    assert payload["operation"] is None
+    assert all(item.state is GateEvidenceState.EVIDENCE_INVALID for item in decision.assessments)
+
+
+def test_decision_authorized_is_not_a_constructor_field() -> None:
+    decision = ReadAuthorizationDecision(
+        ProtectedReadOperation.READ_REPO_FILE,
+        AuthorizationOutcome.DENIED,
+        "test denial",
+        tuple(
+            GateAssessment(gate, requirement, GateEvidenceState.EVIDENCE_NOT_ESTABLISHED)
+            for gate, requirement in (
+                (AuthorizationGate.G1, AuthorizationRequirement.G1_PRINCIPAL_MANDATE),
+                (AuthorizationGate.G2, AuthorizationRequirement.G2_VERSIONED_POLICY_FRESHNESS_REVOCATION),
+                (AuthorizationGate.G3, AuthorizationRequirement.G3_ROOT_DESTINATION_OBJECT_AND_SERVER_BINDING),
+            )
+        ),
+    )
+    assert "authorized" not in {item.name for item in fields(decision)}
+    assert decision.authorized is False
diff --git a/IABV_v1.5/tests/test_rooted_open.py b/IABV_v1.5/tests/test_rooted_open.py
new file mode 100644
index 00000000..986adf7c
--- /dev/null
+++ b/IABV_v1.5/tests/test_rooted_open.py
@@ -0,0 +1,300 @@
+from __future__ import annotations
+
+import ctypes
+import os
+import sys
+from pathlib import Path
+from types import SimpleNamespace
+from types import SimpleNamespace
+
+import pytest
+
+from iabv_v15.infra.mcp.audit_tools import read_repo_file
+from iabv_v15.infra.mcp.audit_tools import rooted_open
+from iabv_v15.infra.mcp.audit_tools.protected_read_composition import ProtectedReadComposer
+from iabv_v15.services.security.read_authorization import (
+    ApprovedWorkspaceRoot,
+    AuthorizationEvidenceBundle,
+    ProtectedReadOperation,
+    ReadDestination,
+    ReadAuthorizationCoordinator,
+    NativeObjectIdentity,
+    TargetObjectKind,
+    RequestedReadTarget,
+    ServerProcessIdentity,
+)
+
+pytestmark = pytest.mark.skipif(sys.platform != "win32", reason="native relative open is Windows-only")
+
+_FILE_READ_ATTRIBUTES = 0x00000080
+_FILE_TRAVERSE = 0x00000020
+_FILE_SHARE_READ = 1
+_FILE_SHARE_WRITE = 2
+_OPEN_EXISTING = 3
+_FILE_FLAG_OPEN_REPARSE_POINT = 0x00200000
+_FILE_FLAG_BACKUP_SEMANTICS = 0x02000000
+
+
+def _root_capability(path: Path) -> rooted_open.NativeWorkspaceRootCapability:
+    kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
+    create_file = kernel32.CreateFileW
+    create_file.argtypes = [
+        ctypes.c_wchar_p, ctypes.c_uint32, ctypes.c_uint32, ctypes.c_void_p,
+        ctypes.c_uint32, ctypes.c_uint32, ctypes.c_void_p,
+    ]
+    create_file.restype = ctypes.c_void_p
+    handle = create_file(
+        str(path), _FILE_READ_ATTRIBUTES | _FILE_TRAVERSE,
+        _FILE_SHARE_READ, None, _OPEN_EXISTING,
+        _FILE_FLAG_BACKUP_SEMANTICS | _FILE_FLAG_OPEN_REPARSE_POINT, None,
+    )
+    if not handle or handle == ctypes.c_void_p(-1).value:
+        raise ctypes.WinError(ctypes.get_last_error())
+    try:
+        return rooted_open.NativeWorkspaceRootCapability._from_host_provider_handle(
+            int(handle),
+            approved_workspace_root=ApprovedWorkspaceRoot("test-root", "v1", "test-root-digest"),
+            provider_id="test-only-open-handle-provider",
+            workspace_context_id="unit-test-workspace",
+            server_process=ServerProcessIdentity("unit-test", os.getpid(), "test-process-digest"),
+            mutation_sharing_denied=True,
+            _issuer_seal=rooted_open._ROOT_ISSUER_SEAL,
+        )
+    finally:
+        kernel32.CloseHandle.argtypes = [ctypes.c_void_p]
+        kernel32.CloseHandle.restype = ctypes.c_int
+        kernel32.CloseHandle(handle)
+
+
+def _open_file(root: rooted_open.NativeWorkspaceRootCapability, relative: str):
+    return rooted_open.open_target_relative_to_root(
+        root,
+        RequestedReadTarget(relative),
+        operation=ProtectedReadOperation.READ_REPO_FILE,
+        destination=ReadDestination("workspace", "v1", "workspace-digest"),
+        evidence=AuthorizationEvidenceBundle(),
+    )
+
+
+def test_root_identity_and_file_identity_are_derived_from_open_handles(tmp_path: Path) -> None:
+    (tmp_path / "nested").mkdir()
