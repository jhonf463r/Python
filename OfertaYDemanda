import yfinance as yf
import requests
from textblob import TextBlob
from pytrends.request import TrendReq
from datetime import datetime, timedelta
import pandas as pd
import concurrent.futures
import time

# Configuración inicial
stock_symbol = "TSLA"  # Tesla
news_url = 'https://gnews.io/api/v4/search'
google_trends = TrendReq(hl='en-US', tz=360)
api_key = 'c5e8a3ddc884a301689fac960289a0d0'  # Reemplaza con tu API key

# Fechas
end_date = datetime.now()
start_date = datetime(2022, 1, 1)

# Crear lista para almacenar los resultados
results = []

# Función para verificar si una fecha es un día hábil
def is_business_day(date):
    return date.weekday() < 5  # Lunes a viernes

# Función para obtener datos de acciones desde Yahoo Finance
def get_stock_data(stock_symbol, start_date, end_date):
    stock = yf.Ticker(stock_symbol)
    hist_data = stock.history(start=start_date, end=end_date)  # Descargar todos los datos de una vez
    return hist_data

# Función para obtener noticias sobre Tesla y analizar sentimiento
def get_news_sentiment(date):
    params = {
        'q': 'Tesla',
        'lang': 'en',
        'token': api_key,
        'from': date.strftime('%Y-%m-%d'),
        'to': (date + timedelta(days=1)).strftime('%Y-%m-%d'),
        'sortby': 'publishedAt',
        'max': 50,
    }
    response = requests.get(news_url, params=params)
    news_sentiment = []
    if response.status_code == 200:
        articles = response.json().get('articles', [])
        for article in articles:
            title = article.get('title', '')
            content = article.get('content', '')
            sentiment_score = TextBlob(title + content).sentiment.polarity
            sentiment_category = 1 if sentiment_score > 0 else -1 if sentiment_score < 0 else 0
            news_sentiment.append(sentiment_category)
    return news_sentiment

# Función para obtener tendencias de búsqueda en Google Trends con reintentos
def get_google_trends_data(date, retries=3, delay=5):
    for attempt in range(retries):
        try:
            timeframe = f"{date.strftime('%Y-%m-%d')} {(date + timedelta(days=1)).strftime('%Y-%m-%d')}"
            google_trends.build_payload(["Tesla"], timeframe=timeframe)
            interest_over_time_df = google_trends.interest_over_time()
            if not interest_over_time_df.empty:
                return interest_over_time_df['Tesla'].mean()
        except Exception as e:
            print(f"Intento {attempt + 1} fallido para Google Trends en {date.strftime('%Y-%m-%d')}: {e}")
            time.sleep(delay)  # Esperar antes de reintentar
    return None

# Función para procesar un día específico
def process_day(date, hist_data):
    if not is_business_day(date) or date > datetime.now():
        print(f"Saltando fecha no hábil o futura: {date.strftime('%Y-%m-%d')}")
        return None

    print(f"Procesando datos para {date.strftime('%Y-%m-%d')}...")
    try:
        # Obtener datos financieros del día
        day_data = hist_data.loc[date.strftime('%Y-%m-%d')]
        if day_data.empty:
            print(f"No se encontraron datos para {date.strftime('%Y-%m-%d')}")
            return None
        
        current_volume = day_data['Volume']
        price = day_data['Close']
        avg_volume = hist_data['Volume'].mean()  # Promedio del volumen
        short_interest = yf.Ticker(stock_symbol).info.get("shortRatio", "No disponible")

        # Obtener sentimiento de noticias
        news_sentiment = get_news_sentiment(date)
        average_sentiment = sum(news_sentiment) / len(news_sentiment) if news_sentiment else 0

        # Obtener Google Trends
        google_trends_score = get_google_trends_data(date)

        # Agregar resultados a la lista
        return {
            'date': date.strftime('%Y-%m-%d'),
            'price': price,
            'current_volume': current_volume,
            'avg_volume': avg_volume,
            'short_interest': short_interest,
            'google_trends_score': google_trends_score,
            'average_sentiment': average_sentiment,
        }
    except Exception as e:
        print(f"Error procesando datos para {date.strftime('%Y-%m-%d')}: {e}")
        return None

# Descargar todos los datos financieros de una vez
hist_data = get_stock_data(stock_symbol, start_date, end_date)

# Recopilar datos día a día en paralelo
with concurrent.futures.ThreadPoolExecutor() as executor:
    futures = []
    current_date = start_date
    while current_date <= end_date:
        futures.append(executor.submit(process_day, current_date, hist_data))
        current_date += timedelta(days=1)
    
    for future in concurrent.futures.as_completed(futures):
        result = future.result()
        if result:
            results.append(result)

# Guardar los resultados en un archivo CSV
df = pd.DataFrame(results)
df.to_csv('tesla_ofertaYdemanda.csv', index=False)

# Resultados guardados correctamente
print("\nDatos guardados en 'tesla_ofertaYdemanda.csv'")
