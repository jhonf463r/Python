news_url = 'https://gnews.io/api/v4/search'

# Fechas
start_date = '2022-10-01'  # Fecha inicial (1 de octubre de 2022)
end_date = datetime.now().strftime('%Y-%m-%d')  # Fecha final (fecha actual)

# Función para obtener noticias y analizar sentimiento
def get_news_sentiment():
    params = {
        'q': 'Tesla',
        'lang': 'en',
        'token': API_KEY,
        'from': start_date,
        'to': end_date,
        'sortby': 'publishedAt',
        'max': 50,
    }
    
    response = requests.get(news_url, params=params)
    news_sentiment = []

    if response.status_code == 200:
        articles = response.json().get('articles', [])
        for article in articles:
            title = article.get('title', '').replace(',', '')
            content = article.get('content', '').replace(',', '')
            sentiment_score = TextBlob(title + content).sentiment.polarity
            sentiment_category = 'Positiva' if sentiment_score > 0 else 'Negativa' if sentiment_score < 0 else 'Neutra'
            news_sentiment.append({
                'title': title,
                'description': article.get('description', '').replace(',', ''),
                'published_at': article.get('publishedAt', ''),
                'sentiment': sentiment_category
            })
    
    return news_sentiment

# Función para guardar los resultados en un archivo CSV
def save_news_to_file(news_data):
    if news_data:
        with open(f'Tesla_geopolitical_news.csv', 'w', encoding='utf-8', newline='') as file:
            writer = csv.DictWriter(file, fieldnames=["title", "description", "published_at", "sentiment"])
            writer.writeheader()
            for news in news_data:
                writer.writerow(news)
        print('Noticias de Tesla guardadas en Tesla_geopolitical_news.csv')
    else:
        print('No se encontraron noticias para Tesla.')

# Obtener las noticias y guardar en CSV
