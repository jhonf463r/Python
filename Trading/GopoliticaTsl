import requests
from textblob import TextBlob
from datetime import datetime
import time

API_KEY = 'c5e8a3ddc884a301689fac960289a0d0'
company = 'Tesla'
geopolitical_terms = ['geopolitical', 'conflict', 'market impact', 'sanctions']
url = 'https://gnews.io/api/v4/search'
start_date = '2023-01-01'
end_date = datetime.now().strftime('%Y-%m-%d')

def get_news(company):
    all_news = []
    page = 1
    query = f"{company} AND ({' OR '.join(geopolitical_terms)})"

    while True:
        params = {
            'q': query,
            'lang': 'en',
            'token': API_KEY,
            'from': start_date,
            'to': end_date,
            'sortby': 'publishedAt',
            'max': 50,
            'page': page
        }

        try:
            response = requests.get(url, params=params)
            response.raise_for_status()
            data = response.json()

            if 'articles' not in data or not data['articles']:
                break

            articles = data['articles']
            for article in articles:
                title = article.get('title', '').replace(',', '')
                description = article.get('description', '').replace(',', '')
                published_at = article.get('publishedAt', '')

                # Convertir la fecha y hora de publicación
                published_datetime = datetime.strptime(published_at, "%Y-%m-%dT%H:%M:%SZ")
                published_date = published_datetime.strftime('%Y-%m-%d')
                published_time = published_datetime.strftime('%H:%M:%S')

                # Análisis de sentimiento
                sentiment = TextBlob(title + description).sentiment.polarity
                sentiment_category = 'Positiva' if sentiment > 0 else 'Negativa' if sentiment < 0 else 'Neutra'

                all_news.append({
                    'title': title,
                    'description': description,
                    'published_date': published_date,
                    'published_time': published_time,
                    'sentiment': sentiment_category
                })

            print(f"Página {page} procesada.")
            page += 1

        except requests.RequestException as e:
            print(f"Error fetching news for {company}: {e}")
            break

        time.sleep(10)

        if page > 5:  # Limitar la paginación
            break

    return all_news

def save_news_to_file(company, news_data):
    if news_data:
        with open(f'{company}_geopolitical_news.csv', 'w', encoding='utf-8') as file:
            file.write('Title,Description,PublishedDate,PublishedTime,Sentiment\n')
            for news in news_data:
                file.write(f"\"{news['title']}\",\"{news['description']}\",\"{news['published_date']}\",\"{news['published_time']}\",\"{news['sentiment']}\"\n")
        print(f'Noticias de {company} guardadas en {company}_geopolitical_news.csv')
    else:
        print(f'No se encontraron noticias para {company}.')

news_data = get_news(company)
save_news_to_file(company, news_data)
