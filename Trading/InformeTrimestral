import os
import requests
from bs4 import BeautifulSoup

company_urls = {
    'TSLA': 'https://ir.tesla.com/#quarterly-disclosure',
    'AMZN': 'https://ir.aboutamazon.com/quarterly-results/default.aspx',
    'NVDA': 'https://investor.nvidia.com/financial-info/quarterly-results/default.aspx', 
    'BABA': 'https://www.alibabagroup.com/en-US/ir-financial-reports-quarterly-results', 
    'GOOGL':'https://abc.xyz/investor/sec-filings/quarterly-filings/2024/', 
    'MSFT': 'https://www.microsoft.com/en-us/Investor/earnings/FY-2024-Q3/press-release-webcast',
    'AAPL': 'https://investor.apple.com/sec-filings/default.aspx'
}

def download_report(company, url):
    print(f"Descargando reportes para {company} desde {url}")
    
    # Realizar la solicitud HTTP a la página web
    response = requests.get(url)
    
    # Verificar si la solicitud fue exitosa
    if response.status_code != 200:
        print(f"Error al acceder a la URL para {company}")
        return
    
    # Parsear el contenido HTML de la página
    soup = BeautifulSoup(response.text, 'html.parser')
    
    # Encontrar el enlace al reporte trimestral correcto
    # Aquí se debe modificar según la estructura HTML de cada página
    if company == 'TSLA':
        # Encontrar enlaces específicos para Tesla
        links = soup.find_all('a', string="Descargar")
    elif company == 'AMZN':
        # Encontrar enlaces específicos para Amazon
        links = soup.find_all('a', string="Comunicado de resultados")
    # Agrega casos para otras compañías aquí...

    # Descargar cada archivo encontrado
    for link in links:
        file_url = link.get('href')
        if file_url:
            file_name = f"{company}_Download.pdf"
            file_path = os.path.join("financial_reports", file_name)
            with open(file_path, 'wb') as file:
                file.write(requests.get(file_url).content)
            print(f"Descargado: {file_path}")

# Descargar reportes para cada compañía
for company, url in company_urls.items():
    download_report(company, url)
