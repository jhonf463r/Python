import inkex
from lxml import etree
from math import sqrt
from itertools import permutations

def distance(p1, p2):
    """Calculate Euclidean distance between two points."""
    return sqrt((p1[0] - p2[0])**2 + (p1[1] - p2[1])**2)

class OptimizeCutPath(inkex.EffectExtension):
    def add_arguments(self, pars):
        pars.add_argument("--active-layer", type=inkex.Boolean, help="Use only objects in the active layer")

    def effect(self):
        # Get all paths or shapes in the current document or active layer
        if self.options.active_layer:
            elements = self.svg.selection
        else:
            elements = self.svg.xpath(".//svg:path", namespaces=inkex.NSS)

        if not elements:
            inkex.errormsg("No paths found in the current selection or document.")
            return

        # Extract the coordinates of all path start points
        points = []
        for elem in elements:
            bbox = elem.bounding_box()
            points.append((bbox.left, bbox.top))

        # Find the optimal path order using a simple TSP solution (brute force for small sets)
        n = len(points)
        best_order = None
        best_distance = float('inf')

        for order in permutations(range(n)):
            dist = sum(distance(points[order[i]], points[order[i+1]]) for i in range(n - 1))
            if dist < best_distance:
                best_distance = dist
                best_order = order

        # Reorder paths in the optimized sequence
        ordered_elements = [elements[i] for i in best_order]

        # Group reordered elements back into the document
        group = etree.Element(inkex.addNS('g', 'svg'))
        for elem in ordered_elements:
            group.append(elem)

        # Append the group to the document
        self.svg.get_current_layer().append(group)

        inkex.utils.debug(f"Optimized cut path order: {best_order}")

if __name__ == '__main__':
    OptimizeCutPath().run()
