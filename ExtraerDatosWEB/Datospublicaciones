import pandas as pd
from selenium import webdriver
from selenium.webdriver.firefox.service import Service
from selenium.webdriver.firefox.options import Options
from selenium.webdriver.common.by import By
import time

# Configuración del navegador Firefox
def configure_browser():
    firefox_options = Options()
    firefox_options.add_argument("--start-maximized")  # Inicia el navegador en pantalla completa
    service = Service('C:\\Users\\faber\\Downloads\\geckodriver-v0.35.0-win32\\geckodriver.exe')  # Ruta al GeckoDriver
    driver = webdriver.Firefox(service=service, options=firefox_options)
    return driver

# Construir la URL con base en item_id y title
def build_url(item_id, title):
    title_formatted = title.replace(" ", "-").replace("+", "-").replace("/", "-").lower()
    url = f"https://articulo.mercadolibre.com.co/MCO-{item_id}-{title_formatted}-_JM"
    return url

# Leer el archivo Excel
file_path = 'C:/Users/faber/Documents/Python/ExtraerDatosWEB/Publicaciones-2025_01_04-16_25.xlsx'  # Cambia esta ruta si es necesario
data = pd.read_excel(file_path)

# Verificar que la columna "Image Src" exista; si no, crearla
if "Image Src" not in data.columns:
    data["Image Src"] = ""

# Configurar navegador
driver = configure_browser()

# Iterar sobre cada fila para buscar el `item_id` y extraer la URL de la imagen
for index, row in data.iterrows():
    item_id = row.get("item_id")  # Asegúrate de que el nombre de la columna sea "item_id"
    title = row.get("title")  # Asegúrate de que el nombre de la columna sea "title"

    if not item_id or not title:
        print(f"Fila {index}: item_id o title faltante, omitiendo...")
        continue

    # Construir la URL de la publicación
    url = build_url(item_id, title)

    try:
        driver.get(url)
        time.sleep(3)  # Esperar a que la página cargue completamente

        # Encontrar la imagen principal
        image_element = driver.find_element(By.XPATH, "//img[contains(@class, 'ui-pdp-image')]")
        image_url = image_element.get_attribute("src")

        # Guardar la URL en el Excel
        data.at[index, "Image Src"] = image_url
        print(f"Fila {index}: Imagen encontrada y guardada - {image_url}")

    except Exception as e:
        print(f"Error procesando item_id {item_id} en fila {index}: {e}")

# Guardar el archivo actualizado
output_path = '/mnt/data/Publicaciones-actualizado.xlsx'  # Cambia esta ruta si es necesario
data.to_excel(output_path, index=False)
print(f"Archivo actualizado guardado en: {output_path}")

# Cerrar el navegador
driver.quit()

print("Proceso completado. Las URLs de las imágenes se han guardado en el archivo Excel.")
